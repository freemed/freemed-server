# Copy to .env (which is gitignored) and fill in real values.
#
#   cp .env.example .env
#   printf 'FREEMED_SESSION_KEY=%s\n' "$(openssl rand -base64 48)" >> .env
#
# or simply: make session-key

# REQUIRED. Signs every JWT credential domain (staff session, patient portal,
# SMART/FHIR access tokens). The server refuses to start if this is missing, is
# the built-in default ("freemed"), or is shorter than 32 bytes.
# Generate with: openssl rand -base64 48
FREEMED_SESSION_KEY=

# Optional overrides (defaults suit the bundled docker-compose stack).
#FREEMED_DB_HOST=db:3306
#FREEMED_DB_USER=freemed
#FREEMED_DB_PASS=freemed
#FREEMED_REDIS_HOST=redis:6379
#FREEMED_LOG_FORMAT=text
